{
  "name": "shipproof",
  "version": "1.0.0",
  "private": true,
  "description": "ShipProof: CI failure triage and noise-free release readiness for Jira (Atlassian Forge)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
