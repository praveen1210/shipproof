    "@forge/react": "^12.6.0",
    "@forge/resolver": "^2.0.2",
    "react": "^18.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@vitest/coverage-v8": "^3.2.4",
    "fast-xml-parser": "^5.12.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "yaml": "^2.9.1"
  }
